{
  "name": "dsh-token-feiyong",
  "version": "1.3.0",
  "description": "DSH（DeepSeek Harness）token 计费插件：内置官方价目表（DeepSeek 分高峰低谷，智谱 GLM 另计），逐笔计算花费（缓存命中 / 未命中 / 输出），含账户余额、单次与本对话统计，侧边对话与子代理的花费并入所属主对话，数据本地持久化。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "docs",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "token",
    "billing",
    "cost",
    "deepseek",
    "cache"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singei8/DSH-TOKEN-feiyong.git"
  },
  "homepage": "https://github.com/singei8/DSH-TOKEN-feiyong#readme",
  "bugs": {
    "url": "https://github.com/singei8/DSH-TOKEN-feiyong/issues"
  }
}
